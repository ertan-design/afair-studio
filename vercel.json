{
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; media-src 'self'; script-src 'self' 'sha256-ERC+yCeelnuLYjFEWTiWYIQNx03yKX0ueS7PUQHThvM='; style-src 'self' 'sha256-yLF5CN5bimUzf41M4zHGrWltI2cWl1P709NRwm5A144=' 'sha256-NsxjH12JlnEZWgeCWUPPCIRR+JislDBOMmGPqMtF7N8='; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/prizma/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/afair-studio-vitrin.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/afair-studio-vitrin",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dila",
      "destination": "/dila/index.html"
    },
    {
      "source": "/dila/",
      "destination": "/dila/index.html"
    },
    {
      "source": "/teknik-sergi",
      "destination": "/teknik-sergi/index.html"
    },
    {
      "source": "/teknik-sergi/",
      "destination": "/teknik-sergi/index.html"
    },
    {
      "source": "/podyum-sahne/kapi",
      "destination": "/podyum-sahne/kapi/index.html"
    },
    {
      "source": "/podyum-sahne/kapi/",
      "destination": "/podyum-sahne/kapi/index.html"
    }
  ]
}
